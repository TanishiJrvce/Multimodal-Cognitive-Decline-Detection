## ── Raw & processed data (large binaries) ──────────────────────────────────
data/raw/
data/processed/audio16k/
data/processed/transcripts/
data/processed/*.npy
data/processed/*.wav

## ── Model checkpoints (can be very large) ───────────────────────────────────
data/models/
*.pt
*.pth

## ── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log

## ── Python cache ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
runs/
.pytest_cache/

## ── OS / editor junk ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
